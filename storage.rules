// Firebase 콘솔 → Storage → Rules 탭에 붙여넣고 "게시"
//
// 사진은 users/{uid}/photos/{id}.jpg 에 저장됩니다.
// 로그인한 사람은 자기 사진만 읽고 쓸 수 있고, 그 외는 전부 거부됩니다.
//
// 크기·형식도 여기서 막습니다. 앱이 올리기 전에 긴 변 1280px(피부 사진만 1600px)
// JPEG로 줄이므로 보통 한 장에 170~220KB입니다. 3MB는 넉넉한 상한입니다.
//
// ⚠️ 콘솔에는 이 파일 전체를 붙여넣으세요. rules_version과 service 껍데기가 빠지면
//    "mismatched input 'match'" 오류가 납니다.

rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/photos/{photo} {
      function mine() { return request.auth != null && request.auth.uid == uid; }

      allow read: if mine();
      allow create: if mine()
                    && request.resource.size < 3 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      // 메타데이터만 고치는 경우(공개 주소 폐기)는 크기·형식을 따지지 않는다.
      // write 하나로 묶어 두면 그 조건들이 메타데이터 수정까지 막는다.
      allow update: if mine();
      allow delete: if mine();
    }
  }
}
