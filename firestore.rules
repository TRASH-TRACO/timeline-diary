// Firebase 콘솔 → Firestore Database → 규칙 탭에 붙여넣고 "게시"
//
// 이 일기장 전용 프로젝트의 규칙입니다.
// 로그인한 사람은 자기 UID 아래의 월별 문서만 읽고 쓸 수 있고, 그 외는 전부 거부됩니다.
//
//   users/{uid}/diary/{YYYY-MM}   ← 그 달의 일기와 트랙 기록이 문서 하나에
//   users/{uid}/diary/settings    ← 어떤 트랙을 쓰는지 같은 설정
//
// 문서 id를 가리지 않고 diary 아래 전부에 같은 규칙을 걸므로, 나중에 문서가
// 늘어나도 규칙은 그대로다.
//
// 주의: 하위 컬렉션은 상위 문서의 규칙을 물려받지 않습니다.
//       users/{uid} 문서 자체는 이 앱이 쓰지 않으므로 규칙도 두지 않습니다.

rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/diary/{monthKey} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
